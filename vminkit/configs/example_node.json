  },
  "doe": {
    "_comment": "비워두면 논문 값(2000 조건, Vop 0.4~0.8, PCG64, read seed 2027 / write seed 2028, 아래 범위). 노드에 맞게 바꿀 것만 적는다.",
    "n_cond": 2000,
    "vops": [
      0.4,
      0.5,
      0.6,
      0.7,
      0.8
    ],
    "ranges": {
      "cn": [
        -60,
        60
      ],
      "pu": [
        -60,
        60
      ],
      "sk": [
        -20,
        20
      ],
      "loc": [
        0.7,
        1.3
      ],
      "mom": [
        0.7,
        1.3
      ],
      "l_sk": [
        -0.075,
        0.075
      ],
      "m_sk": [
        -0.075,
        0.075
      ]
