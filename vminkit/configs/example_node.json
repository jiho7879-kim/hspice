  "modes": {
    "read": {
      "metric": "SNMR",
      "temperature_C": 125,
      "template_dir": "/path/to/read_templates",
      "template_glob": "*{prefix}-{start}_{vop}V*.in",
      "deck_out_dir": "/path/to/read_sim_dir",
      "sim_dirs": [
        "/path/to/read_sim_dir"
      ],
      "result": {
        "type": "single",
        "pattern": "{stem}.mt0",
        "measure": "snmr_diagonal"
      },
      "value_unit": "V",
      "snm_floor_mV": 0.0,
      "_template": "00_gen_decks: template_dir 의 Vop별 template(예: ...-TT-1_0.4V-125C.in)으로 deck_out_dir 에 덱 생성. 01_extract: 시뮬레이션이 끝난 sim_dirs 에서 덱+.mt0 를 읽음 (보통 deck_out_dir 와 같은 폴더)."
    },
    "write": {
      "metric": "Vtrip",
      "temperature_C": -40,
      "template_dir": "/path/to/write_templates",
      "template_glob": "*{prefix}-{start}_{vop}V*.in",
      "deck_out_dir": "/path/to/write_sim_dir",
      "sim_dirs": [
        "/path/to/write_sim_dir"
      ],
      "result": {
        "type": "single",
        "pattern": "{stem}.mt0",
        "measure": "bwrm_min",
        "_other": "a0/a1 두 파일로 나뉜 경우: {\"type\": \"min_left_right\", \"left_pattern\": \"{stem}*a0*.mt0\", \"right_pattern\": \"{stem}*a1*.mt0\", \"left_measure\": \"bwrm_1\", \"right_measure\": \"bwrm_2\"}"
      },
      "value_unit": "V",
      "snm_floor_mV": null
    }
  }
